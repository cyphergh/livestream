generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PRODUCER
  USER
}

enum ChannelType {
  RADIO
  TV
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum AccessType {
  FREE
  SUBSCRIPTION
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  password   String
  role       Role     @default(USER)
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  channels      Channel[]       @relation("ChannelOwner")
  refreshTokens RefreshToken[]
  chatMessages  ChatMessage[]
  mediaAssets   MediaAsset[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Channel {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  type        ChannelType @default(TV)
  visibility  Visibility  @default(PUBLIC)
  // TV monetization: free-to-air or subscription.
  accessType  AccessType  @default(FREE)
  logoUrl     String?
  coverUrl    String?
  ownerId     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner         User           @relation("ChannelOwner", fields: [ownerId], references: [id])
  sessions      Session[]      @relation("ChannelSessions")
  programs      Program[]
  ingestKeys    IngestKey[]
  restreams     RestreamTarget[]
  pullSources   PullSource[]
  chatMessages  ChatMessage[]
  overlay       Overlay?

  @@index([ownerId])
}

model Session {
  id           String   @id @default(cuid())
  channelId    String
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  title        String?
  isLive       Boolean  @default(true)
  scheduled    Boolean  @default(false)
  scheduledFor DateTime?

  channel Channel @relation("ChannelSessions", fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model Program {
  id         String   @id @default(cuid())
  channelId  String
  title      String
  description String?
  startsAt   DateTime
  endsAt     DateTime
  genre      String?
  createdAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, startsAt, endsAt])
}

model IngestKey {
  id         String      @id @default(cuid())
  channelId  String
  name       String      @default("Primary")
  protocol   String      @default("rtmp") // rtmp | rtsp | srt | whep
  password   String
  enabled    Boolean     @default(true)
  createdAt  DateTime    @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model RestreamTarget {
  id        String   @id @default(cuid())
  channelId String
  name      String
  url       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model PullSource {
  id        String    @id @default(cuid())
  channelId String
  name      String
  url       String
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

// Visual overlay rendered on top of the video for viewers. One per channel.
// mode: off | ticker (scrolling marquee) | image (static logo/picture) | text
model Overlay {
  id           String  @id @default(cuid())
  channelId    String  @unique
  channel      Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  mode         String  @default("off") // off | ticker | image | text
  // Show the channel logo on the top-right corner of TV playback (even in fullscreen).
  logoVisible  Boolean @default(true)

  // ---- ticker (scrolling marquee) ----
  text         String  @default("")
  position     String  @default("bottom") // ticker: bottom|top, static: + corners & center
  fontSize     Int     @default(28)
  color        String  @default("#ffffff")
  bgColor      String  @default("rgba(0,0,0,0.55)")
  speed        Int     @default(12) // px/s scroll speed

  // ---- shared ----
  opacity      Float   @default(0.85) // 0..1

  // ---- image overlay ----
  imageUrl     String?
  width        Int?
  height       Int?
  borderRadius Int     @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// CMS media library: uploaded images and videos (videos are transcoded to VOD
// HLS by the server, images served as-is). The `published` flag controls which
// assets appear on the public landing page.
model MediaAsset {
  id          String       @id @default(cuid())
  type        MediaType
  name        String
  description String?
  mime        String
  size        Int
  status      MediaStatus  @default(PROCESSING)
  url         String
  posterUrl   String?
  duration    Int? // seconds, video only
  published   Boolean      @default(false)
  uploadedById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([type, published])
}

// Editable landing-page content (key/value). Admin manages these from the CMS;
// the public /api/content endpoint exposes them to the guest site.
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}